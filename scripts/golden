#!/usr/bin/env python3
"""Writes the golden vectors the Swift core is tested against, from the Python engine (the oracle).

Synthetic fixtures only (tests/fixtures). Output: core/Tests/HomemeshCoreTests/Golden/*.json.
Run from the repository root with the project's environment:  .venv/bin/python scripts/golden
Regenerate when the model changes on purpose; the diff in review shows what moved.
`api_session.json` is a frozen recording of the retired server's API (61 requests, invented houses): the Swift LocalAPI replays it,
but nothing regenerates it any more, since the FastAPI layer is gone.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from homemesh import propagation as P  # noqa: E402
from homemesh import rates  # noqa: E402
from homemesh.model import House  # noqa: E402

OUT = ROOT / "core" / "Tests" / "HomemeshCoreTests" / "Golden"
FIXTURES = ["one_floor_box", "two_floor_stairwell", "long_thin", "wired_ends"]


def house(name: str) -> House:
    return House.model_validate_json((ROOT / "tests" / "fixtures" / f"{name}.json").read_text())


def propagation_cases() -> list[dict]:
    cases = []
    for name in FIXTURES:
        h = house(name)
        params = P.Params(n={"2.4": 2.2, "5": 2.6, "6": 3.0}, extra_loss={"2.4": 1.0, "5": 2.0, "6": 3.0})
        for lv in h.levels:
            if not any(w.level == lv.id for w in h.walls):
                continue
            grid = P.level_grid(h, lv.id, step=1.0, rx_height=1.0)
            pts = grid.points()
            rx = np.column_stack([pts, np.full(len(pts), grid.z)])
            for tx_level in [x.id for x in h.levels][:2]:
                tz = P.level_z(h)[tx_level] + 1.8
                pos = (float(np.mean(pts[:, 0])), float(np.mean(pts[:, 1])))
                for band in ("2.4", "5", "6"):
                    loss = P.path_loss(h, (pos[0], pos[1], tz), rx, band, params)
                    cases.append({"fixture": name, "grid_level": lv.id, "tx_level": tx_level, "tx": [pos[0], pos[1], tz], "band": band,
                                  "grid": {"x0": grid.x0, "y0": grid.y0, "step": grid.step, "nx": grid.nx, "ny": grid.ny, "z": grid.z},
                                  "n": params.n, "extra_loss": params.extra_loss, "loss": [round(float(v), 9) for v in loss],
                                  "mask": [bool(v) for v in P.grid_mask(h, grid)]})
    return cases


def rate_cases() -> list[dict]:
    out = []
    for std, widths in (("n", (20, 40)), ("ac", (20, 80, 160)), ("ax", (20, 80, 160))):
        for width in widths:
            for streams in (1, 2, 4):
                snrs = [float(x) for x in np.arange(-5, 45, 0.5)]
                out.append({"standard": std, "width": width, "streams": streams, "snr": snrs,
                            "rate": [round(float(v), 9) for v in rates.throughput(np.array(snrs), std, width, streams)]})
    return out


def import_scenarios() -> list[dict]:
    """Scan imports: the same synthetic RoomPlan JSON the Python tests use, with the house the Python import produces step by step."""
    import copy
    from homemesh import roomplan as R
    from homemesh.materials import default_materials
    from homemesh.model import Level, Slab, Stair
    from tests.roomplan_synth import room, surface, two_rooms

    def base(jog=0.3, two=False):
        lv = [Level(id="L0", name="Ground", elevation=0.0, height=2.5)]
        if two:
            lv.append(Level(id="L1", name="First", elevation=2.8, height=2.5, slab=Slab(material="slab-wood", thickness=0.3)))
        return House(id="h", name="h", synthetic=True, materials=default_materials(), jog_fold=jog, levels=lv)

    def wrap(*rooms):
        return {"format": "homemesh-capture-1", "rooms": list(rooms)}

    def stairs_in(r, cx, cz, w=1.0, d=3.0, rise=2.7, axis=(1, 0)):
        ux, uz = axis
        r["objects"].append({"identifier": "st", "category": {"stairs": {}}, "dimensions": [w, rise, d],
                             "transform": [ux, 0, uz, 0, 0, 1, 0, 0, -uz, 0, ux, 0, cx, 1.0, cz, 1]})
        return r

    def dump(h: House) -> dict:
        return json.loads(h.model_dump_json())

    def rep_dict(r) -> dict:
        d = {k: getattr(r, k) for k in ("walls", "paired_walls", "openings", "skipped_openings", "rooms", "replaced", "curved_walls", "profile_walls", "folded_jogs", "furniture")}
        d["stairs"] = r.stairs
        d["notes"] = r.notes
        return d

    def run(name, house, steps):
        cur, out = house, []
        for st in steps:
            op = st["op"]
            if op == "import":
                tr = R.Similarity2D(**st["transform"]) if st.get("transform") else None
                cur, rep = R.import_capture(cur, st["data"], st["level"], st["blob"], tr, names=st.get("names"), descriptions=st.get("descriptions"),
                                            room_levels=st.get("room_levels"))
                out.append({**st, "expect": dump(cur), "report": rep_dict(rep)})
            elif op == "apply_stair":
                notes: list[str] = []
                found = [dict(f) for f in R.stair_footprints(st["data"])]
                cur = R.apply_stair(cur, st["data"], st["blob"], st["meta"], None, found, notes)
                out.append({**st, "found": found, "expect": dump(cur), "notes": notes})
            elif op == "retire":
                cur, gone = R.retire_room(cur, st["data"], st["blob"], st["index"])
                out.append({**st, "expect": dump(cur), "gone": gone})
        return {"name": name, "house": dump(house), "steps": out}

    B = "A" * 64
    sc = []
    sc.append(run("two rooms", base(), [{"op": "import", "data": two_rooms(), "level": "L0", "blob": B}]))
    sc.append(run("two rooms, nested transforms", base(), [{"op": "import", "data": two_rooms(nested=True), "level": "L0", "blob": B}]))
    sc.append(run("two rooms placed, named", base(), [{"op": "import", "data": two_rooms(), "level": "L0", "blob": B,
                                                      "transform": {"scale": 1.0, "rotation": 30.0, "tx": 5.0, "ty": -3.0},
                                                      "names": ["Kitchen", "Pantry"], "descriptions": ["the big one", ""]}]))
    r = room(0, 0, 6, 4, "A")
    r["walls"][0]["polygonCorners"] = [[-3, -1.25, 0], [3, -1.25, 0], [3, 0.25, 0], [0, 1.25, 0], [-3, 0.25, 0]]
    r["walls"][1]["polygonCorners"] = [[-2, -1.25, 0], [2, -1.25, 0], [2, 1.25, 0], [-2, 1.25, 0]]
    sc.append(run("gable wall keeps its outline", base(), [{"op": "import", "data": wrap(r), "level": "L0", "blob": B}]))
    r = room(0, 0, 6, 4, "A")
    r["walls"][0]["curve"] = {"radius": 4.0, "startAngle": -0.7, "endAngle": 0.7}
    sc.append(run("curved wall becomes chords", base(), [{"op": "import", "data": wrap(r), "level": "L0", "blob": B}]))
    r = room(0, 0, 6, 4, "A")
    r["walls"][0]["curve"] = {"radius": 1.0, "startAngle": 0.0, "endAngle": 1.0}
    sc.append(run("curve that cannot fit", base(), [{"op": "import", "data": wrap(r), "level": "L0", "blob": B}]))

    def jogged():
        r = room(0, 0, 6, 4, "A")
        r["walls"][0:1] = [surface("wall", (1.5, 1.25, 0.0), (1, 0), 3.0, 2.5, "A-s1"), surface("wall", (3.0, 1.25, 0.1), (0, 1), 0.2, 2.5, "A-jog"),
                           surface("wall", (4.5, 1.25, 0.2), (1, 0), 3.0, 2.5, "A-s2")]
        return wrap(r)

    sc.append(run("jog folded", base(), [{"op": "import", "data": jogged(), "level": "L0", "blob": B}]))
    sc.append(run("jog not folded", base(jog=0.0), [{"op": "import", "data": jogged(), "level": "L0", "blob": B}]))
    sc.append(run("jog then retire the room", base(), [{"op": "import", "data": jogged(), "level": "L0", "blob": B}, {"op": "retire", "data": jogged(), "blob": B, "index": 0}]))
    r = room(0, 0, 1.6543, 3, "A", doors=[(1.6543, 1.5, 0, 1)])
    sc.append(run("door at the very end of a wall", base(), [{"op": "import", "data": wrap(r), "level": "L0", "blob": B}]))
    st = wrap(stairs_in(room(0, 0, 6, 4, "A"), 2.0, 1.5, rise=2.7), )
    sc.append(run("stairs found, floors given", base(two=True), [
        {"op": "import", "data": st, "level": "L0", "blob": B},
        {"op": "apply_stair", "data": st, "blob": B, "meta": {"stair": {"from_level": "L0", "to_level": "L1"}}}]))
    plain = wrap(room(0, 0, 6, 4, "A", doors=[(0.0, 1.5, 1, 0)]))
    sc.append(run("stairs scan without a stairs object", base(two=True), [
        {"op": "import", "data": plain, "level": "L0", "blob": B},
        {"op": "apply_stair", "data": plain, "blob": B, "meta": {"stair": {"from_level": "L0", "to_level": "L1"}, "purpose": "stairs"}}]))
    sc.append(run("re-import replaces and keeps names", base(), [
        {"op": "import", "data": two_rooms(), "level": "L0", "blob": B, "names": ["Kitchen", "Pantry"]},
        {"op": "import", "data": two_rooms(), "level": "L0", "blob": B, "names": ["Kitchen", "Larder"]}]))
    sc.append(run("one scan on two floors", base(two=True), [{"op": "import", "data": two_rooms(), "level": "L0", "blob": B, "room_levels": [None, "L1"]}]))
    sc.append(run("rescan one room", base(), [{"op": "import", "data": two_rooms(), "level": "L0", "blob": B}, {"op": "retire", "data": two_rooms(), "blob": B, "index": 1}]))
    return json.loads(json.dumps(sc))


def place_scenarios() -> list[dict]:
    """Placement by labelled doors, the doors checklist, the first scan of a floor and an empty plan, from the Python engine."""
    import copy
    import math
    from homemesh import connections, place
    from homemesh.materials import default_materials
    from homemesh.model import Level, Slab, Stair
    from homemesh.roomplan import import_capture, stair_footprints
    from tests.roomplan_synth import room, two_rooms
    from tests.test_place import empty_house, moved, wrap
    from tests.test_stairs import two_level_house, with_stairs

    def dump(h):
        return json.loads(h.model_dump_json())

    a, b = two_rooms()["rooms"]
    A, B = "A" * 64, "B" * 64
    out = []

    def add(name, house, scan, level, blob, **kw):
        res = place.propose(house, scan, level, blob, **kw)
        out.append({"name": name, "house": dump(house), "scan": scan, "level": level, "blob": blob,
                    "names": kw.get("names"), "door_labels": kw.get("door_labels") or {}, "plan_labels": kw.get("plan_labels") or {}, "expect": res})

    house, _ = import_capture(empty_house(), wrap(a), "L0", A, names=["Kitchen"])
    scan = wrap(moved(wrap(b), 37, 5, -3)["rooms"][0])
    plan_labels = {A + "#A-door0": "Pantry"}
    add("labelled connection", house, scan, "L0", B, names=["Pantry"], door_labels={"B-door0": "kitchen"}, plan_labels=plan_labels)
    add("no labels", house, scan, "L0", B, names=["Pantry"])
    add("one way", house, scan, "L0", B, names=["Pantry"], door_labels={"B-door0": "Kitchen"})
    add("elsewhere", house, scan, "L0", B, names=["Pantry"], door_labels={"B-door0": "Garage"}, plan_labels=plan_labels)
    add("outside", house, scan, "L0", B, names=["Pantry"], door_labels={"B-door0": "Outside"}, plan_labels=plan_labels)
    a2 = room(0, 0, 4, 3, "A", doors=[(4.0, 1.0, 0, 1), (4.0, 2.2, 0, 1)])
    b2 = room(4.12, 0, 8.12, 3, "B", doors=[(4.12, 1.0, 0, 1), (4.12, 2.2, 0, 1)])
    house2, _ = import_capture(empty_house(), wrap(a2), "L0", A, names=["Kitchen"])
    scan2 = wrap(moved(wrap(b2), 20, 2, 3)["rooms"][0])
    add("two connections", house2, scan2, "L0", B, names=["Pantry"], door_labels={"B-door0": "Kitchen", "B-door1": "Kitchen"},
        plan_labels={A + "#A-door0": "Pantry", A + "#A-door1": "Pantry"})
    add("empty plan", empty_house(), wrap(moved(wrap(b), 20, 0, 0)["rooms"][0]), "L0", B)
    th = two_level_house()
    lower = wrap(with_stairs(room(0, 0, 6, 4, "A"), 2.0, 1.5))
    th, rep = import_capture(th, lower, "L0", A)
    poly = [tuple(p) for p in rep.stairs[0]["polygon"]]
    th = th.model_copy(update={"stairs": [Stair(id="s1", from_level="L0", to_level="L1", polygon=poly)]})
    upper = moved(wrap(with_stairs(room(10, 10, 15, 14, "U"), 11.5, 12.0)), 53, 4, -2)
    add("first scan of a floor by the staircase", th, upper, "L1", "U" * 64)

    metas = [
        {"blob": "k" * 64, "name": "Kitchen scan", "level": "L0", "at": 1, "rooms": ["Kitchen"], "doors": [{"id": "d1", "room": 0, "number": 1}, {"id": "d2", "room": 0, "number": 2}],
         "door_labels": {"d1": "Pantry", "d2": "Outside"}},
        {"blob": "p" * 64, "name": "Pantry scan", "level": "L0", "at": 2, "rooms": ["Pantry"], "doors": [{"id": "e1", "room": 0, "number": 1}], "door_labels": {"e1": "Kitchen"}},
        {"blob": "h" * 64, "name": "Hall scan", "level": "L0", "at": 3, "rooms": ["Hall"], "doors": [{"id": "f1", "room": 0, "number": 1}, {"id": "f2", "room": 0, "number": 2}],
         "door_labels": {"f1": "Study"}},
        {"blob": "s" * 64, "name": "stairs", "level": "L0", "at": 4, "rooms": ["S"], "doors": [], "purpose": "stairs"},
    ]
    return json.loads(json.dumps({"scenarios": out, "checklist": {"metas": metas, "expect": connections.checklist(metas)}}))


def plan_scenarios() -> list[dict]:
    """Planner runs: arrangements, scores, zones and backhaul of the top results, from the Python engine."""
    from homemesh import catalogue as C
    from homemesh.jobs import serialise
    from homemesh.model import Need, Zone
    from homemesh.network import Context, Policy
    from homemesh.planner import PlanConfig, search

    cat = C.load(owner_dir=None)
    out = []

    def run(name, h, trust, step, k_max):
        params = P.Params(n={"2.4": 3.2, "5": 3.4, "6": 3.6}, extra_loss={"2.4": 2.0, "5": 3.0, "6": 4.0})
        ctx = Context(h, cat.equipment, cat.clients["phone-2x2-ax"], params=params, step=1.0)
        cfg = PlanConfig(equipment=("generic-mesh-ax", "generic-mesh-tri"), k_max=k_max, candidate_step=step, policy=Policy(trust_unknown_jacks=trust))
        results = search(ctx, cfg, cat.equipment)
        from homemesh.explain import explain
        from homemesh.network import Placement
        gw = Placement(cfg.gateway_equipment, h.entry.position, h.entry.level, cfg.gateway_height)
        exps = []
        for i in range(min(3, len(results) - 1)):
            ex = explain(ctx, gw, results[i], results[i + 1], cfg, samples=12)
            exps.append({"index": i, "zones": [{"zone": z.zone, "limiter": z.limiter, "detail": z.detail, "mean_rate": z.mean_rate, "frac_target": z.frac_target, "utility": z.utility} for z in ex.zones],
                         "node_contribution": [[n, c] for n, c in ex.node_contribution], "vs": ex.vs_runner_up, "stability": ex.stability, "depends_on_jacks": ex.depends_on_jacks, "lines": ex.lines})
        out.append({"explanations": exps, "name": name, "house": json.loads(h.model_dump_json()), "n": params.n, "extra_loss": params.extra_loss, "client": "phone-2x2-ax", "grid": 1.0, "equipment": list(cfg.equipment),
                    "k_max": k_max, "candidate_step": step, "trust_unknown_jacks": trust, "count": len(results),
                    "results": [serialise(r) for r in results[:12]]})

    wired = house("wired_ends")
    wired = wired.model_copy(update={"zones": [z.model_copy(update={"need": Need(min_throughput=700, must=True)}) if z.kind == "demand" else z for z in wired.zones]})
    run("hall, unknown jack not trusted", wired, False, 3.0, 3)
    run("hall, unknown jack trusted", wired, True, 3.0, 3)
    box = house("one_floor_box")
    zs = [Zone(id="z-allow", level="L0", kind="allow", polygon=[(0, 0), (10, 0), (10, 8), (0, 8)], requires="none"),
          Zone(id="z-office", level="L0", kind="demand", name="Office", polygon=[(6, 4), (9.5, 4), (9.5, 7.5), (6, 7.5)], weight=3.0, need=Need(min_throughput=900, must=True)),
          Zone(id="z-bed", level="L0", kind="demand", name="Bed", polygon=[(0.5, 5), (4.5, 5), (4.5, 7.5), (0.5, 7.5)], weight=1.0, need=Need(min_throughput=700))]
    run("box, demanding zones", box.model_copy(update={"zones": zs}), False, 2.0, 2)
    return json.loads(json.dumps(out))


def calibration_scenarios() -> list[dict]:
    """Calibration fits on invented readings of an invented house: the fit, the accepted house and the planner's margin."""
    import numpy as np
    from homemesh import calibration as K
    from homemesh.model import AccessPoint, Measurement

    out = []
    h = house("one_floor_box")
    ap = AccessPoint(id="ap1", name="Existing", position=(1.0, 1.0), level="L0", height=1.5, eirp_dbm=23.0)
    truth = h.model_copy(update={"materials": [m.model_copy(update={"loss": {b: v + (3.0 if m.id == "brick" else 1.0 if m.id == "drywall" else 0.0) for b, v in m.loss.items()}}) for m in h.materials]})
    params = P.Params(n={"2.4": 2.6, "5": 2.8, "6": 3.0}, extra_loss={"2.4": 3.0, "5": 4.0, "6": 5.0})
    rng = np.random.default_rng(7)
    ms = []
    k = 0
    for band in ("5", "2.4"):
        for i in range(30):
            x, y = float(rng.uniform(0.6, 9.4)), float(rng.uniform(0.6, 7.4))
            tx = (ap.position[0], ap.position[1], ap.height)
            loss = float(P.path_loss(truth, tx, np.array([[x, y, 1.0]]), band, params)[0])
            rssi = ap.eirp_dbm - loss + float(rng.normal(0, 2.0))
            k += 1
            ms.append(Measurement(id=f"m{k}", position=(round(x, 3), round(y, 3)), level="L0", device="phone", band=band, rssi=round(rssi, 2)))
    h2 = h.model_copy(update={"access_points": [ap], "measurements": ms})
    fits = K.fit(h2)
    applied = K.apply(h2, fits, now=None)

    def pf(p):
        return {"mean": p.mean, "sd": p.sd, "prior_mean": p.prior_mean, "prior_sd": p.prior_sd, "identified": p.identified}

    out.append({"name": "two bands, 30 readings each", "house": json.loads(h2.model_dump_json()),
                "fits": {b: {"n_meas": f.n_meas, "n": pf(f.n), "extra_loss": pf(f.extra_loss), "materials": {k: pf(v) for k, v in f.materials.items()}, "sigma": f.sigma,
                             "rmse_train": f.rmse_train, "rmse_cv": f.rmse_cv, "bias_cv": f.bias_cv, "residuals": f.residuals, "note": f.note} for b, f in fits.items()},
                "applied_materials": json.loads(applied.model_dump_json())["materials"], "applied_calibration": {k: v for k, v in json.loads(applied.model_dump_json())["calibration"].items() if k != "at"},
                "margin": K.margin_for(applied), "params": {"n": K.params_for(applied).n, "extra": K.params_for(applied).extra_loss}})
    few = h2.model_copy(update={"measurements": ms[:5]})
    out.append({"name": "too few readings", "house": json.loads(few.model_dump_json()), "fits": {}, "margin": K.margin_for(few)})
    return json.loads(json.dumps(out))


def same(a, b, tol: float = 1e-9) -> bool:
    """Equal JSON, numbers within `tol` (relative): linear algebra differs in the last digits between machines."""
    if isinstance(a, dict) and isinstance(b, dict):
        return a.keys() == b.keys() and all(k == "at" or same(a[k], b[k], tol) for k in a)   # `at` is a time stamp (the clock is not repeatable)
    if isinstance(a, list) and isinstance(b, list):
        return len(a) == len(b) and all(same(x, y, tol) for x, y in zip(a, b))
    if isinstance(a, (int, float)) and isinstance(b, (int, float)) and not isinstance(a, bool) and not isinstance(b, bool):
        return abs(a - b) <= tol * max(1.0, abs(a), abs(b))
    return a == b


def files() -> dict[str, str]:
    out = {"propagation.json": json.dumps(propagation_cases()), "rates.json": json.dumps(rate_cases()), "imports.json": json.dumps(import_scenarios()), "places.json": json.dumps(place_scenarios()), "plans.json": json.dumps(plan_scenarios()), "calibrations.json": json.dumps(calibration_scenarios())}
    for name in FIXTURES:
        out[f"{name}.house.json"] = (ROOT / "tests" / "fixtures" / f"{name}.json").read_text()
    return out


def main() -> int:
    want = files()
    if "--check" in sys.argv:   # the committed vectors must be what the Python engine writes now
        stale = [n for n, t in want.items() if not (OUT / n).exists() or not same(json.loads((OUT / n).read_text()), json.loads(t))]
        if stale:
            print("golden vectors are stale:", stale, "(run scripts/golden)")
            return 1
        return 0
    OUT.mkdir(parents=True, exist_ok=True)
    for n, t in want.items():
        (OUT / n).write_text(t)
    print("wrote", sorted(want))
    return 0


if __name__ == "__main__":
    sys.exit(main())
