#!/usr/bin/env bash
# The repository's one verify command (dev.toml [verify]): install the pinned
# dependencies into .venv, then run every Python test with unittest. CI runs the
# same command.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
fi
# Reinstall only when the lock file changed.
stamp=.venv/.lock-stamp
if [ ! -f "$stamp" ] || ! cmp -s requirements.lock "$stamp"; then
  .venv/bin/pip install --quiet --disable-pip-version-check -r requirements.lock
  cp requirements.lock "$stamp"
fi

.venv/bin/python -B -m unittest discover -s tests -t . -v

# Front end: type-check and build (node if present, else a node container).
if command -v node >/dev/null 2>&1; then
  (cd web && npm ci --no-audit --no-fund --silent && npm run build --silent)
elif command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$PWD/web":/w -w /w node:22-slim sh -c 'npm ci --no-audit --no-fund --silent && npm run build --silent'
else
  echo "verify: need node or docker to build the front end" >&2
  exit 1
fi
