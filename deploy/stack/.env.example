# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (`stack env-set homemesh NAME`), never committed.
TS_AUTHKEY=                  # one-off, single-use, tagged tag:homemesh (first join only)
OIDC_ISSUER=                 # https://id.<tailnet>
OIDC_HOST=                   # id.<tailnet>
OIDC_CLIENT_ID=              # the door's Pocket ID client: homemesh (confidential, PKCE)
OIDC_CLIENT_SECRET=
OIDC_CAPTURE_CLIENT_ID=      # the iOS app's Pocket ID client: homemesh-capture (public, PKCE); not a secret
ID_TAILNET_IP=               # the id node's tailscale IPv4
HOMEMESH_FQDN=               # homemesh.<tailnet>
HOMEMESH_DATA=               # /data: the container path of the state/data bind
HOMEMESH_AUTH_HEADER=        # X-Forwarded-User: the header the door sets and strips from callers
# OAUTH2_PROXY_COOKIE_SECRET is generated on the host
# HOMEMESH_IMAGE is written by each deploy (the pin)
