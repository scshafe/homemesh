#!/usr/bin/env bash
# Runs before XcodeGen generates the project (options.preGenCommand in project.yml): bakes the git commit and a
# build number (commits on this branch) into the app, so every build can be told apart in the diagnostics.
# Writes two git-ignored files: HomemeshCapture/BuildInfo.generated.swift and Build.generated.xcconfig.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
commit="$(git -C "$here" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"
git -C "$here" diff --quiet HEAD -- 2>/dev/null || commit="$commit+dirty"
count="$(git -C "$here" rev-list --count HEAD 2>/dev/null || echo 1)"
cat > "$here/HomemeshCapture/BuildInfo.generated.swift" <<SWIFT
// Generated by ios/stamp-build; not committed.
enum BuildInfo {
    static let commit = "$commit"
    static let number = "$count"
}
SWIFT
printf 'CURRENT_PROJECT_VERSION = %s\n' "$count" > "$here/Build.generated.xcconfig"
